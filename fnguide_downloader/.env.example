# 이 파일을 .env 로 복사한 뒤 값을 채우세요 (.env 는 git에 올라가지 않습니다)
FNGUIDE_ID=아이디
FNGUIDE_PW=비밀번호

# 리포트 목록 페이지 주소 (로그인 후 목록 화면의 주소창 URL)
LIST_URL=

# Google Drive for desktop 의 '주식전략' 폴더 경로
# Windows 예: G:\내 드라이브\주식전략   /  Mac 예: /Users/이름/Library/CloudStorage/GoogleDrive-.../내 드라이브/주식전략
SAVE_DIR=G:\내 드라이브\주식전략

HEADLESS=true

# 화면 구조에 맞게 조정 (기본값으로 안 되면 --inspect 결과를 보고 수정)
# ROW_SELECTOR=table tbody tr
# LINK_SELECTOR=a
# DOWNLOAD_SELECTOR=text=다운로드 >> visible=true
